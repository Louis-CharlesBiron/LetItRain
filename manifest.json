{
  "name": "Let It Rain",
  "description": "todo",
  "version": "1",
  "version_name": "1.0.0",
  "manifest_version": 3,
  "icons": {
      "128": "./assets/img/logo.png"
  },
  "commands": {
    "_execute_action": { 
      "suggested_key": {
        "default": "Alt+Shift+W",
        "linux": "Alt+Shift+W",
        "windows": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      }
    }
  },
  "action": {
    "default_title": "Rain configuration",
      "default_popup": "popup.html"
  },
  "content_scripts": [{
      "matches": ["<all_urls>"],
      "js": ["constants.js", "./overlay/canvasDotEffect.js", "./overlay/RainManager.js", "./overlay/overlay.js"],
      "run_at": "document_idle"
  }],
  "permissions": [
    "storage"
  ],
  "host_permissions": ["<all_urls>"]
}